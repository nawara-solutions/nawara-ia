{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .claude/hooks/design-doc-conformance-trigger.sh ]; then bash .claude/hooks/design-doc-conformance-trigger.sh; fi",
            "statusMessage": "Checking design-doc conformance..."
          }
        ]
      }
    ]
  }
}
